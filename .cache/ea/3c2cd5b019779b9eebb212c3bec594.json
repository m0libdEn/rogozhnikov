r\n    min-width: 60%;\r\n    border-radius: 12px;\r\n    padding: 20px;\r\n    border: none;;\r\n    font-size: 18px;\r\n    font-weight: 400;\r\n    line-height: 24px;;\r\n}\r\n.header__cart {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items:center;\r\n}\r\n.header__cart-wrapper {\r\n    max-width: 28px;\r\n    max-height: 28px;\r\n}\r\n.header__cart-logo {\r\n    width: 100%;\r\n    height: 100%;\r\n    margin-bottom: 6px;\r\n}\r\n.header__title {\r\n    color: rgba(255, 255, 255, 0.6);\r\n    font-size: 13.78px;\r\n    font-weight: 400;\r\n    line-height: 20px;\r\n    letter-spacing: 0%;\r\n    text-align: left;\r\n}\r\n.btn{\r\n    width: 100%;\r\n    color:#fff;\r\n    font-size: 14px;\r\n    font-weight: 600;\r\n    line-height: 20px;\r\n    text-align: center;\r\n    padding: 10px 0px;\r\n    background-color:#1d976c;\r\n    border:none;\r\n    border-radius: 14px;\r\n    &:hover{\r\n        background-color:#2be6a5;\r\n        transition:ease-in 0.1ms;\r\n    }\r\n}\r\n.list {\r\n    padding-top: 161px;\r\n    display: grid;\r\n    grid-template-columns: repeat(5, 1fr);\r\n    grid-gap: 20px;\r\n}\r\n.product__image {\r\n    height: 100%;\r\n    width: 100%;\r\n    object-fit: cover;\r\n    border-radius: 10px;\r\n}\r\n.product__price {\r\n    color: #1d976c;\r\n    font-size: 16.03px;\r\n    font-weight: 700;\r\n    line-height: 24px;\r\n    margin-bottom: 20px;\r\n}\r\n.product__name {\r\n    font-size: 14px;\r\n    font-weight: 400;\r\n    line-height: 20px;\r\n    text-align: left;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n\r\n.product__image-container{\r\n    position: relative;\r\n    display:inline-block;\r\n    height: 320px;\r\n    margin-bottom: 15px;\r\n    &:hover{\r\n        .product__image{\r\n         filter: blur(5px);\r\n         transition:ease-in-out 0.5s \r\n        }\r\n        .product__overlay-btn{\r\n            opacity: 1;\r\n            transition:ease-in-out 0.5s \r\n        }\r\n    }\r\n}\r\n.product__overlay-btn{\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    font-size: 14px;\r\n    max-width: 80%;\r\n    opacity: 0;\r\n    cursor: pointer;\r\n}","css\\style.css":"@import url(\"https://fonts.googleapis.com/css2?family=Segoe+UI&display=swap\");\n* {\n  padding: 0;\n  margin: 0;\n  box-sizing: border-box;\n  font-family: \"Segoe UI\", sans-serif;\n}\n\n.container {\n  max-width: 1200px;\n  padding: 0 15px;\n  margin: 0 auto;\n}\n\n.header {\n  background: linear-gradient(135deg, #1d976c 10%, #93f9b9 100%);\n  position: fixed;\n  padding: 47px 0px 20px 0px;\n  width: 100%;\n  z-index: 100;\n}\n\n.header__container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.header__logo {\n  height: 100%;\n  color: white;\n  font-size: 40px;\n  font-weight: 700;\n  letter-spacing: 0%;\n  text-align: left;\n  text-decoration: none;\n}\n\n.header__search {\n  min-width: 60%;\n  border-radius: 12px;\n  padding: 20px;\n  border: none;\n  font-size: 18px;\n  font-weight: 400;\n  line-height: 24px;\n}\n\n.header__cart {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.header__cart-wrapper {\n  max-width: 28px;\n  max-height: 28px;\n}\n\n.header__cart-logo {\n  width: 100%;\n  height: 100%;\n  margin-bottom: 6px;\n}\n\n.header__title {\n  color: rgba(255, 255, 255, 0.6);\n  font-size: 13.78px;\n  font-weight: 400;\n  line-height: 20px;\n  letter-spacing: 0%;\n  text-align: left;\n}\n\n.btn {\n  width: 100%;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 20px;\n  text-align: center;\n  padding: 10px 0px;\n  background-color: #1d976c;\n  border: none;\n  border-radius: 14px;\n}\n.btn:hover {\n  background-color: #2be6a5;\n  transition: ease-in 0.1ms;\n}\n\n.list {\n  padding-top: 161px;\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  grid-gap: 20px;\n}\n\n.product__image {\n  height: 100%;\n  width: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  border-radius: 10px;\n}\n\n.product__price {\n  color: #1d976c;\n  font-size: 16.03px;\n  font-weight: 700;\n  line-height: 24px;\n  margin-bottom: 20px;\n}\n\n.product__name {\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 20px;\n  text-align: left;\n  margin-bottom: 6px;\n}\n\n.product__image-container {\n  position: relative;\n  display: inline-block;\n  height: 320px;\n  margin-bottom: 15px;\n}\n.product__image-container:hover .product__image {\n  filter: blur(5px);\n  transition: ease-in-out 0.5s;\n}\n.product__image-container:hover .product__overlay-btn {\n  opacity: 1;\n  transition: ease-in-out 0.5s;\n}\n\n.product__overlay-btn {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-size: 14px;\n  max-width: 80%;\n  opacity: 0;\n  cursor: pointer;\n}/*# sourceMappingURL=style.css.map */"},"lineCount":null}},"error":null,"hash":"acb49b2679c5667f8af53188486d21ea","cacheData":{"env":{}}}