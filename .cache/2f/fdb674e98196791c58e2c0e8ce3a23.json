n":20},"generated":{"line":1,"column":1964}},{"source":"javascript/script.js","name":"createElement","original":{"line":111,"column":29},"generated":{"line":1,"column":1973}},{"source":"javascript/script.js","original":{"line":111,"column":43},"generated":{"line":1,"column":1987}},{"source":"javascript/script.js","original":{"line":122,"column":0},"generated":{"line":1,"column":1993}},{"source":"javascript/script.js","name":"showCart","original":{"line":122,"column":9},"generated":{"line":1,"column":2002}},{"source":"javascript/script.js","name":"productList","original":{"line":123,"column":4},"generated":{"line":1,"column":2006}},{"source":"javascript/script.js","name":"style","original":{"line":123,"column":16},"generated":{"line":1,"column":2008}},{"source":"javascript/script.js","name":"display","original":{"line":123,"column":22},"generated":{"line":1,"column":2014}},{"source":"javascript/script.js","original":{"line":123,"column":32},"generated":{"line":1,"column":2022}},{"source":"javascript/script.js","name":"productList","original":{"line":112,"column":0},"generated":{"line":1,"column":2030}},{"source":"javascript/script.js","name":"className","original":{"line":112,"column":12},"generated":{"line":1,"column":2032}},{"source":"javascript/script.js","original":{"line":112,"column":24},"generated":{"line":1,"column":2042}},{"source":"javascript/script.js","name":"cart","original":{"line":116,"column":0},"generated":{"line":1,"column":2055}},{"source":"javascript/script.js","name":"appendChild","original":{"line":116,"column":5},"generated":{"line":1,"column":2057}},{"source":"javascript/script.js","name":"productList","original":{"line":116,"column":17},"generated":{"line":1,"column":2069}},{"source":"javascript/script.js","name":"cart","original":{"line":119,"column":0},"generated":{"line":1,"column":2072}},{"source":"javascript/script.js","name":"addEventListener","original":{"line":119,"column":5},"generated":{"line":1,"column":2074}},{"source":"javascript/script.js","original":{"line":119,"column":22},"generated":{"line":1,"column":2091}},{"source":"javascript/script.js","name":"showCart","original":{"line":119,"column":35},"generated":{"line":1,"column":2103}}],"sources":{"javascript/script.js":"const URL='https://6615ddf3b8b8e32ffc7bdc0a.mockapi.io/product'\r\nconst list =document.getElementById('list')\r\nconst cart = document.getElementById('cart')\r\n\r\nlet cartArr = [] // array of items which will be on cart\r\n\r\nfunction getProducts(){ //getting all prodtucts from API\r\n    return new Promise((resolve, reject)=>{\r\n        fetch(URL)\r\n        .then(response => {\r\n            if(response.ok){\r\n                resolve(response.json())\r\n            }else reject(new Error('problem with api'))\r\n        })\r\n    })\r\n}\r\n\r\nfunction setData(key ,el){ //add data (that will be 4 cart & product list)\r\n    localStorage.setItem(key,JSON.stringify(el))\r\n}\r\nfunction getData(key){ //get data (that will be also 4 cart & product list)\r\n    return JSON.parse(localStorage.getItem(key))\r\n}\r\n\r\nfunction loadData(){\r\n    let storedCart = getData('cart')\r\n    console.log(storedCart);\r\n    if(storedCart){\r\n        storedCart.forEach(el => layoutCart(el))\r\n    }\r\n}\r\nfunction layoutProduct(el) {\r\n    const listProduct = document.createElement('div');\r\n    listProduct.classList.add('list-product');\r\n\r\n    const imageContainer = document.createElement('div');\r\n    imageContainer.classList.add('product__image-container');\r\n\r\n    const image = document.createElement('img');\r\n    image.classList.add('product__image');\r\n    image.src = el.photo;\r\n    image.alt = 'product';\r\n\r\n    const overlayButton = document.createElement('button');\r\n    overlayButton.classList.add('product__overlay-btn', 'btn');\r\n    overlayButton.textContent = 'Быстрый просмотр';\r\n\r\n    const infoContainer = document.createElement('div');\r\n    infoContainer.classList.add('product__info');\r\n\r\n    const priceParagraph = document.createElement('p');\r\n    priceParagraph.classList.add('product__price');\r\n    priceParagraph.textContent = el.price;\r\n\r\n    const nameHeading = document.createElement('h3');\r\n    nameHeading.classList.add('product__name');\r\n    nameHeading.textContent = el.name;\r\n\r\n    const addButton = document.createElement('button');\r\n    addButton.classList.add('product__btn', 'btn');\r\n    addButton.textContent = 'Добавить в Корзину';\r\n    addButton.addEventListener('click', function() {\r\n        layoutCart(el);\r\n    });\r\n\r\n    listProduct.appendChild(imageContainer);\r\n    imageContainer.appendChild(image);\r\n    imageContainer.appendChild(overlayButton);\r\n    listProduct.appendChild(infoContainer);\r\n    infoContainer.appendChild(priceParagraph);\r\n    infoContainer.appendChild(nameHeading);\r\n    listProduct.appendChild(addButton);\r\n\r\n    list.appendChild(listProduct);\r\n}\r\n\r\n\r\nfunction layoutCart(el){\r\n    const productInCart = document.createElement('div')\r\n    productInCart.classList.add('product');\r\n    const nameInCart = document.createElement('p')\r\n    nameInCart.id = 'nameInCart';\r\n    nameInCart.classList.add('nameInCart');\r\n    nameInCart.innerHTML=el.name\r\n    const priceInCart = document.createElement('p');\r\n    priceInCart.id = 'price';\r\n    priceInCart.classList.add('price');\r\n    priceInCart.innerHTML = el.price\r\n    const photoInCart = document.createElement('img');\r\n    photoInCart.id = 'photo';\r\n    photoInCart.classList.add('photo');\r\n    photoInCart.src = `${el.photo}`\r\n    cart.appendChild(productInCart)\r\n    productInCart.appendChild(photoInCart);\r\n    productInCart.appendChild(nameInCart);\r\n    productInCart.appendChild(priceInCart);\r\n    cartArr.push(el)\r\n    setData('cart',cartArr)\r\n\r\n}\r\n\r\ngetProducts()\r\n.then(products => products.forEach(el=>layoutProduct(el)))\r\n.then()\r\n\r\nwindow.addEventListener('load',function(){\r\n    loadData()\r\n})\r\n\r\n// Создаем список товаров\r\nconst productList = document.createElement('ul');\r\nproductList.className = 'cart__list';\r\n// Здесь вы можете добавить элементы списка товаров вручную или сгенерировать их с помощью JavaScript\r\n\r\n\r\ncart.appendChild(productList);\r\n\r\n// Добавляем обработчик события наведения мыши на корзину\r\ncart.addEventListener('mouseover', showCart);\r\n\r\n// Функция, которая показывает корзину с товарами\r\nfunction showCart() {\r\n    productList.style.display = 'block';\r\n}\r\n"},"lineCount":null}},"error":null,"hash":"74ab5458de39d34e406cb9eebb514c9d","cacheData":{"env":{}}}